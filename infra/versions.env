# Pinned versions for the Selenium Grid. Keep SELENIUM_VERSION in step with the
# selenium Python package in pyproject.toml. Changing a version means updating its
# SHA-256 too: bundle.sh refuses artifacts whose checksum doesn't match.

SELENIUM_VERSION=4.49.0
SELENIUM_JAR_SHA256=8221cb7bf687b8ca13c31c2bca9fb8cc12e9d4c808baff670c66cb0e450ceb35

GECKODRIVER_VERSION=0.37.0
GECKODRIVER_SHA256=90d4e33bd9816684400c160d1309aaffec23a3f65103511d5a62d8501062e548

# RPMs, installed with dnf from your internal mirror (Satellite, Pulp...), or from
# rpms/ in the bundle when built with `bundle.sh --with-rpms`.
JAVA_PACKAGE=java-21-openjdk-headless
FIREFOX_PACKAGE=firefox            # RHEL/Rocky/Alma AppStream ships Firefox ESR

# Where things are installed on the hub and nodes.
SELENIUM_HOME=/opt/selenium
SELENIUM_CONF=/etc/selenium
SELENIUM_USER=selenium
GECKODRIVER_PATH=/usr/local/bin/geckodriver

# Ports. Changing these also means updating the firewall notes in infra/README.md.
HUB_PORT=4444                       # runner -> hub (WebDriver + BiDi websocket)
EVENT_BUS_PUBLISH_PORT=4442         # node -> hub
EVENT_BUS_SUBSCRIBE_PORT=4443       # node -> hub
NODE_PORT=5555                      # hub -> node
